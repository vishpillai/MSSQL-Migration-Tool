    <MediaTemplate CompressionLevel="high" />
    <Feature Id="MainFeature" Title="Db Migration Tool" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppStartMenuShortcut" />
      <ComponentRef Id="AppDesktopShortcut" />
    </Feature>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="DbMigrationTool" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <Component Id="AppStartMenuShortcut" Directory="ProgramMenuFolder" Guid="{2D9E0C4A-F9A1-4A55-B4F6-09D0CBF82E0D}">
      <Shortcut Id="AppShortcut" Name="Db Migration Tool" Target="[INSTALLFOLDER]Start-DbMigrationWeb.cmd" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\DbMigrationTool" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="AppDesktopShortcut" Directory="DesktopFolder" Guid="{919DEE3A-6F4E-4EA8-A09B-0F8A356D82B2}">
      <Shortcut Id="DesktopShortcut" Name="Db Migration Tool" Target="[INSTALLFOLDER]Start-DbMigrationWeb.cmd" WorkingDirectory="INSTALLFOLDER" />
